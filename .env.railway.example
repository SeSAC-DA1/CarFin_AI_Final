# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CARFIN AI - Railway 프로덕션 환경 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🌍 환경 설정
NODE_ENV=production
PORT=8000

# 🗄️ PostgreSQL 데이터베이스 (Railway Database)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 🔥 Railway Redis (Add-on 추가 후 자동 생성)
REDIS_URL=${{Redis.REDIS_URL}}

# 🤖 AI 서비스 설정
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# 🔐 보안 설정
SESSION_SECRET=your_super_secure_session_secret_for_production

# 🌐 CORS 설정 (배포 도메인)
CORS_ORIGIN=https://your-app-name.up.railway.app

# 📊 모니터링 설정 (선택사항)
ENABLE_METRICS=true
LOG_LEVEL=info

# 🎯 성능 최적화 설정
CACHE_TTL_DEFAULT=300
CACHE_TTL_SEARCH=600
CACHE_TTL_TOPSIS=300
CACHE_TTL_AI_RESPONSE=1800

# 🚀 API 설정
API_RATE_LIMIT=100
API_TIMEOUT=30000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Railway 배포 가이드
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1. Railway 프로젝트 생성
#    railway login
#    railway init
#    railway link [project-id]

# 2. PostgreSQL 추가
#    railway add postgresql

# 3. Redis 추가
#    railway add redis

# 4. 환경 변수 설정
#    railway variables set GOOGLE_API_KEY=your_api_key
#    railway variables set SESSION_SECRET=your_secret

# 5. 배포
#    railway up
#    railway domain  # 커스텀 도메인 설정

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Railway 서비스 URL 예시
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PostgreSQL: ${{Postgres.DATABASE_URL}}
# Redis: ${{Redis.REDIS_URL}}
# 예: redis://default:password@redis.railway.internal:6379