# 🚀 프로덕션 환경 설정 (Railway 배포용)

# 백엔드 API URL (Railway 자동 설정)
VITE_BACKEND_URL=https://carfin-ai-backend.railway.app

# 🔒 보안 설정
NODE_ENV=production
VITE_NODE_ENV=production

# 📊 성능 모니터링
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# 🚀 최적화 설정
VITE_ENABLE_SOURCE_MAPS=false
VITE_ENABLE_BUNDLE_ANALYZER=false

# 🎯 버전 정보 (교육/공모전용)
VITE_APP_VERSION=1.0.0
VITE_BUILD_TARGET=production
VITE_COMPETITION_MODE=true

# 🌐 CDN 및 캐싱 설정
VITE_CDN_URL=https://cdn.carfin.ai
VITE_ASSET_CACHE_DURATION=31536000

# 📡 WebSocket 설정
VITE_WS_RECONNECT_ATTEMPTS=10
VITE_WS_HEARTBEAT_INTERVAL=30000