# ========================================
# AWS 배포용 환경변수 설정
# ========================================

# ========================================
# 데이터베이스 설정
# ========================================

# AWS RDS PostgreSQL
DATABASE_URL=postgresql://username:password@your-db.abc123.us-east-1.rds.amazonaws.com:5432/carfin_db
DB_TYPE=aws-rds
DB_SSL=true
# DB_CA_CERT=/path/to/rds-combined-ca-bundle.pem  # AWS RDS CA 인증서 (TLS 검증용)

# ========================================
# 캐시 설정 (ElastiCache Valkey)
# ========================================

# ElastiCache Valkey 엔드포인트
ELASTICACHE_ENDPOINT=your-cache.abc123.cache.amazonaws.com:6379
ELASTICACHE_TLS=true
# ELASTICACHE_PASSWORD=your_password  # 인증 활성화 시
# ELASTICACHE_CA_CERT=/path/to/redis-ca.pem  # ElastiCache CA 인증서 (TLS 검증용)

# ========================================
# AI 및 보안
# ========================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret (랜덤 문자열)
SESSION_SECRET=your_random_session_secret_here

# ========================================
# 서버 설정
# ========================================

# 포트 (AWS 환경에 따라 자동 설정)
PORT=3000

# Node 환경
NODE_ENV=production

# ========================================
# 마이그레이션 설정 (scripts/export-to-rds.ts용)
# ========================================

# 소스 데이터베이스 (Neon, Railway 등)
# DATABASE_URL=postgresql://source_user:password@source_host:5432/source_db

# 대상 데이터베이스 (AWS RDS)
# AWS_RDS_URL=postgresql://rds_user:password@your-rds.abc123.us-east-1.rds.amazonaws.com:5432/carfin_db
